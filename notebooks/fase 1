        "id": "47eAXFvits5Y"
      },
      "source": [
        "### FollowBench (reglas de seguimiento de instrucciones)\n",
        "\n",
        "Aquí se evalúa si cada reseña cumple condiciones definidas en el prompt:\n",
        "- longitud entre 90 y 130 palabras\n",
        "- no usar listas\n",
        "- no mencionar IA/modelo de lenguaje\n",
        "- presencia de ≥2 aspectos positivos (medido por palabras clave)\n",
        "- presencia de ≥1 aspecto negativo (medido por palabras clave)\n",
        "\n",
        "La puntuación final es la proporción de checks cumplidos (0–1)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "dujsdBCtxAYK"
      },
      "outputs": [],
      "source": [
        "import re\n",
        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "wILg7hUDyesP"
      },
      "outputs": [],
      "source": [
        "# Listas de palabras positivas y negativas utilizadas como heurística.\n",
        "# Se usan para aproximar la condición:\n",
        "# \"Presencia de al menos 2 aspectos positivos\" y \"Presencia de al menos 1 aspecto negativo\".\n",
        "\n",
        "POSITIVE_WORDS = [\n",
        "    \"bueno\", \"excelente\", \"cómodo\", \"práctico\", \"útil\",\n",
        "    \"recomendable\", \"calidad\", \"satisfecho\", \"funciona bien\"\n",
        "]\n",
        "\n",
        "NEGATIVE_WORDS = [\n",
        "    \"pero\", \"aunque\", \"problema\", \"mejoraría\",\n",
        "    \"negativo\", \"inconveniente\", \"defecto\"\n",
        "]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "42p0wURQy-5s"
      },
      "outputs": [],
      "source": [
        "# Funciones de verificación (cada una devuelve True/False)\n",
        "\n",
        "def word_count(text):\n",
        "    return len(text.split())\n",
        "\n",
        "def check_length(text):\n",
        "    wc = word_count(text)\n",
        "    return 90 <= wc <= 130\n",
        "\n",
        "def check_no_lists(text):\n",
        "    # Detecta patrones típicos de listas: viñetas, numeración, etc.\n",
        "    return not bool(re.search(r\"(\\n-|•|\\d+\\.)\", text))\n",
        "\n",
        "def check_no_ai_mentions(text):\n",
        "    # Evita referencias explícitas a IA/modelo de lenguaje.\n",
        "    return not bool(re.search(\n",
        "        r\"(modelo de lenguaje|inteligencia artificial|IA)\",\n",
        "        text.lower()\n",
        "    ))\n",
        "\n",
        "def check_positive_aspects(text):\n",
        "    # Cuenta ocurrencias de términos positivos (heurística basada en lista).\n",
        "    text_l = text.lower()\n",
        "    return sum(word in text_l for word in POSITIVE_WORDS) >= 2\n",
        "\n",
        "def check_negative_aspect(text):\n",
        "    # Verifica si aparece al menos un indicador negativo.\n",
        "    text_l = text.lower()\n",
        "    return any(word in text_l for word in NEGATIVE_WORDS)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XCApHHu_zG6I"
      },
