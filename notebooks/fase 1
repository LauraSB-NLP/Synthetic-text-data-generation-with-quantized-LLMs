    {
      "cell_type": "markdown",
      "metadata": {
        "id": "hRYgAzd2ukES"
      },
      "source": [
        "### Generación de dataset para evaluar\n",
        "\n",
        "Se definen varios escenarios (producto/persona/rating). Para cada escenario y modelo se generan `K_PER_PROMPT` reseñas.\n",
        "\n",
        "**Campos guardados por reseña**\n",
        "- `model`: nombre del modelo y cuantización.\n",
        "- `product`, `persona`, `rating`: variables del escenario.\n",
        "- `prompt`: prompt completo usado.\n",
        "- `sample_id`: índice de la muestra dentro del escenario.\n",
        "- `text`: reseña generada."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "RJP95aJLyJRq"
      },
      "outputs": [],
      "source": [
        "PRODUCT_PROMPTS = [\n",
        "    {\"product\": \"Auriculares inalámbricos\", \"persona\": \"usuario que hace deporte\", \"rating\": 4},\n",
        "    {\"product\": \"Cafetera espresso\", \"persona\": \"amante del café en casa\", \"rating\": 5},\n",
        "    {\"product\": \"Teclado mecánico\", \"persona\": \"programador\", \"rating\": 3},\n",
        "    {\"product\": \"Mochila de viaje\", \"persona\": \"viajero de fin de semana\", \"rating\": 4},\n",
        "    {\"product\": \"Robot aspirador\", \"persona\": \"hogar con mascota\", \"rating\": 2},\n",
        "]\n",
        "\n",
        "def build_review_prompt(product, persona, rating):\n",
        "    # Construye el prompt final (texto) incorporando variables del escenario.\n",
        "    return f\"\"\"\n",
        "Escribe una reseña realista de un producto para una tienda online.\n",
        "\n",
        "Producto: {product}\n",
        "Perfil del comprador: {persona}\n",
        "Valoración: {rating} de 5\n",
        "\n",
        "Requisitos:\n",
        "- Entre 90 y 130 palabras.\n",
        "- Tono natural y humano.\n",
        "- Incluye 2 aspectos positivos y 1 negativo.\n",
        "- No uses listas.\n",
        "- No menciones que eres un modelo de lenguaje.\n",
        "\n",
        "Reseña:\n",
        "\"\"\".strip()\n",
        "\n",
        "def generate_review(llm, prompt, max_tokens=200, temperature=0.8, top_p=0.9):\n",
        "    # Función genérica (no chat) para modelos configurados como callable.\n",
        "    # Nota: más abajo se redefine generate_review usando create_chat_completion.\n",
        "    out = llm(\n",
        "        prompt,\n",
        "        max_tokens=max_tokens,\n",
        "        temperature=temperature,\n",
        "        top_p=top_p,\n",
        "        stop=[\"\\n\\n\"],\n",
        "    )\n",
        "    return out[\"choices\"][0][\"text\"].strip()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "background_save": true
        },
        "collapsed": true,
        "id": "gP2Ga0Yewuta"
      },
      "outputs": [],
      "source": [
        "from tqdm import tqdm\n",
        "import pandas as pd\n",
        "\n",
        "# Diccionario de modelos a comparar (claves: etiquetas legibles, valores: objetos Llama cargados)\n",
        "llms = {\n",
        "    \"LLaMA 3.1 Instruct (8B, Q4_K_M)\": llm_llama31,\n",
        "    \"LLaMA 3.2 Instruct (3B, Q4_K_M)\": llm_llama32,\n",
        "    \"Gemma 3 Instruct (4B, Q4_K_M)\": llm_gemma,\n",
        "}\n",
        "\n",
        "rows = []\n",
        "K_PER_PROMPT = 10  # nº de reseñas por combinación (modelo × escenario)\n",
        "\n",
        "def generate_review(llm, prompt, max_tokens=240, temperature=0.8, top_p=0.9):\n",
        "    # Generación vía chat_completion (formato instruct). Los parámetros controlan aleatoriedad:\n",
        "    # - temperature: dispersión en muestreo\n",
        "    # - top_p: nucleus sampling\n",
        "    out = llm.create_chat_completion(\n",
        "        messages=[\n",
        "            {\"role\": \"user\", \"content\": prompt}\n",
        "        ],\n",
        "        max_tokens=max_tokens,\n",
        "        temperature=temperature,\n",
        "        top_p=top_p,\n",
        "    )\n",
        "    return out[\"choices\"][0][\"message\"][\"content\"].strip()\n",
        "\n",
        "for model_name, llm in llms.items():\n",
        "    # Recorre escenarios y genera K reseñas por escenario.\n",
        "    for p in tqdm(PRODUCT_PROMPTS, desc=f\"Generando con {model_name}\"):\n",
        "        prompt = build_review_prompt(**p)\n",
        "        for i in range(K_PER_PROMPT):\n",
        "            text = generate_review(llm, prompt)\n",
        "            rows.append({\n",
        "                \"model\": model_name,\n",
        "                \"product\": p[\"product\"],\n",
        "                \"persona\": p.get(\"persona\", None),\n",
        "                \"rating\": p.get(\"rating\", None),\n",
        "                \"prompt\": prompt,\n",
        "                \"sample_id\": i,\n",
        "                \"text\": text\n",
        "            })\n",
        "\n",
        "df = pd.DataFrame(rows)\n",
        "\n",
        "# Vista rápida del dataset generado\n",
        "display(df.head())\n",
        "\n",
        "# Guardar dataset generado\n",
        "df.to_csv(\"generated_reviews.csv\", index=False)\n",
        "print(\"Guardado en generated_reviews.csv\")"
      ]
    },
