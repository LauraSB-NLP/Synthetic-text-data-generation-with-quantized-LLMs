      "outputs": [],
      "source": [
        "# Librerías auxiliares:\n",
        "# - nltk: tokenización para Distinct-n\n",
        "# - pandas: gestión tabular del dataset generado\n",
        "# - tqdm: barras de progreso durante la generación\n",
        "!pip install nltk pandas tqdm"
      ]
    },
