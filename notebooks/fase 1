        "# (Incluye utilidades para cargar modelos desde Hugging Face mediante from_pretrained.)\n",
        "!pip install -U llama-cpp-python"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "collapsed": true,
