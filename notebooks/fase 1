      "outputs": [],
      "source": [
        "# RAM tras la primera generación: útil para detectar picos de memoria asociados a inferencia/cachés.\n",
        "process = psutil.Process(os.getpid())\n",
        "print(f\"RAM tras generar texto: {process.memory_info().rss / 1024**3:.2f} GB\")"
      ]
